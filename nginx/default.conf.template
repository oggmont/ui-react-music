# Rendered by the nginx image's entrypoint (envsubst): ${API_UPSTREAM} and ${NGINX_LOCAL_RESOLVERS}.

# Behind Cloud Run's HTTPS front end nginx sees plain HTTP: pass on the original scheme.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

# The caller's IP. Cloud Run's front end appends the real client address as the LAST entry of
# X-Forwarded-For, so earlier entries (which a client can send itself) are ignored.
map $http_x_forwarded_for $client_ip {
    default                  $remote_addr;
    "~(?<last>[^,\s]+)\s*$"  $last;
}

# Brute-force protection: log in, refresh and sign up are limited per client IP (other requests
# get an empty key, which nginx doesn't limit). Per instance; Cloud Run runs at most two.
map "$request_method:$uri" $auth_limit_key {
    default                              "";
    "~^POST:/api/v1/auth/"               $client_ip;
    "~^POST:/api/v1/users/?$"            $client_ip;
}
limit_req_zone $auth_limit_key zone=auth:1m rate=10r/m;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Resolve the API's host name per request, so nginx starts even when the API is down.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Security headers. A location with its own add_header drops these, so those repeat them.
    # Browsers ignore HSTS over plain HTTP, so it's harmless in local Docker.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Same-origin API: the browser calls /api/v1/..., nginx forwards it unchanged.
    # API_UPSTREAM is the API container (http://music-api:8080) in Docker, or the API's
    # Cloud Run URL (https://runlist-api-....run.app) on GCP. Cloud Run routes by Host and
    # SNI, so both carry the upstream's host name, not the UI's.
    location /api/ {
        limit_req zone=auth burst=10 nodelay;
        limit_req_status 429;
        client_max_body_size 1m;

        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        # A cold API start on Cloud Run takes a few seconds; leave room for it.
        proxy_connect_timeout 30s;
        proxy_read_timeout 60s;
        # Same-origin for the browser, so no CORS: don't let the API's CORS filter judge our origin.
        proxy_set_header Origin "";
    }

    # Hashed build assets never change: cache them for a year.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        try_files $uri =404;
    }

    # Client-side routes (/songs, /playlists/20, /u/ana.garcia) all load index.html.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Frame-Options "DENY" always;
        try_files $uri $uri/ /index.html;
    }
}
