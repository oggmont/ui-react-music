# Copy to .env (cp .env.example .env). Both `npm run dev` and docker compose read it.

# Where the dev server forwards /api. Local run: the API's host port. Docker: the API's
# container name on the shared network (set in docker-compose.yml).
API_PROXY_TARGET=http://localhost:8081

# Port of the dev server on this machine (Docker).
UI_PORT=5173
# Port of the production image (nginx) on this machine: docker compose --profile prod up.
UI_PROD_PORT=8082

# Extra host names allowed to open the dev server (comma-separated). "music-ui", the
# container name, is always allowed so e2e tests on the Docker network can reach it.
# ALLOWED_HOSTS=

# Use polling for file watching if hot reload misses changes in Docker.
WATCH_POLLING=false

# Optional: an absolute API base URL baked into the bundle. Leave empty to call /api/v1 on
# the same origin (through the dev proxy or nginx).
# VITE_API_BASE_URL=
